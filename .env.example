# LLM Provider — set to "groq" or "gemini" (default: groq)
LLM_PROVIDER=groq

# Groq API key — free at console.groq.com
GROQ_API_KEY=

# Gemini API key — free at aistudio.google.com
GEMINI_API_KEY=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

USE_LIVE_DATA=false
NEWS_API_KEY=
